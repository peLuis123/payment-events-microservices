AWS_REGION=us-east-2
NODE_ENV=production
SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/YOUR_ACCOUNT_ID/payment-queue
SQS_QUEUE_ARN=arn:aws:sqs:us-east-2:YOUR_ACCOUNT_ID:payment-queue
DYNAMODB_TABLE=Orders
DYNAMODB_TABLE_ARN=arn:aws:dynamodb:us-east-2:YOUR_ACCOUNT_ID:table/Orders
SNS_TOPIC_ARN=arn:aws:sns:us-east-2:YOUR_ACCOUNT_ID:payment-events
